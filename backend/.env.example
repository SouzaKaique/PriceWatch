# Copie para .env e ajuste. O arquivo .env NÃO é versionado.
SECRET_KEY=troque-por-um-valor-aleatorio
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Opcional: exige o cabeçalho X-API-Key em /api/* (exceto /api/health).
# Deixe vazio enquanto a API só escutar em 127.0.0.1.
API_ACCESS_KEY=

# Consultas às lojas: intervalo mínimo por domínio e pausa após bloqueio (segundos).
HTTP_MIN_INTERVAL_SECONDS=5
HTTP_BLOCK_COOLDOWN_SECONDS=1800

# Mercado Livre — API oficial (app gratuito criado por você em
# https://developers.mercadolivre.com.br/devcenter). Veja o README.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Precisa ser idêntica à URL de redirecionamento cadastrada no app (https).
ML_REDIRECT_URI=

# Intervalo do monitoramento automático, em minutos.
CHECK_INTERVAL_MINUTES=120

# Notificações no celular (gratuitas, sem cartão) — veja o README.
# Telegram: crie um bot no @BotFather e cole o token aqui.
TELEGRAM_BOT_TOKEN=
# (opcional) normalmente detectado pelo app; preencha só se quiser fixar.
TELEGRAM_CHAT_ID=
# ntfy: escolha um tópico longo e aleatório (funciona como senha) e assine-o no app ntfy.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# Web Push: chaves geradas automaticamente em instance/vapid_private.pem.
# (opcional) contato exigido pelo protocolo VAPID: mailto:... ou https://...
VAPID_SUBJECT=

# Celular no Wi-Fi com HTTPS próprio: rode "python configurar_wifi.py" (preenche estas linhas).
HTTPS_CERT_FILE=
HTTPS_KEY_FILE=
HTTPS_PORT=5443
CERT_PAGE_PORT=5001
